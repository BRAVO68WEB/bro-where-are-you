# =============================================================================
# Bro Where Are You — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=bwhere
POSTGRES_USER=bwhere
DB_PASSWORD=CHANGE_ME

# --- Hasura GraphQL Engine ---------------------------------------------------
HASURA_ADMIN_SECRET=CHANGE_ME
HASURA_WEBHOOK_SECRET=CHANGE_ME

# --- Deployment (Dokploy) -----------------------------------------------------
# Used by Traefik labels for Host routing (api.${DOMAIN}, grpc.${DOMAIN})
DOMAIN=example.com

# --- Go Server ----------------------------------------------------------------
API_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME_must_be_at_least_32_chars

# --- OIDC Authentication -----------------------------------------------------
# Your OIDC provider's JWKS endpoint (used by Hasura to verify JWTs)
OIDC_JWKS_URL=https://your-oidc-provider/.well-known/jwks.json

# --- OneSignal Push Notifications --------------------------------------------
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key
ONESIGNAL_SAFARI_WEB_ID=web.onesignal.auto.your-safari-web-id

# --- Valhalla (optional snap-to-road) ----------------------------------------
# To enable: set LOAD_VALHALLA=true and VALHALLA_URL, then:
#   docker compose --profile valhalla up -d
LOAD_VALHALLA=false
OSM_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf
# VALHALLA_URL=http://valhalla:8002
