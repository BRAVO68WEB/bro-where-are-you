FROM node:24-alpine AS builder
WORKDIR /app

ARG VITE_HASURA_URL
ARG VITE_HASURA_ADMIN_SECRET
ARG VITE_API_URL
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_ONESIGNAL_APP_ID
ARG VITE_ONESIGNAL_SAFARI_WEB_ID

ENV VITE_HASURA_URL=$VITE_HASURA_URL
ENV VITE_HASURA_ADMIN_SECRET=$VITE_HASURA_ADMIN_SECRET
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_ONESIGNAL_APP_ID=$VITE_ONESIGNAL_APP_ID
ENV VITE_ONESIGNAL_SAFARI_WEB_ID=$VITE_ONESIGNAL_SAFARI_WEB_ID

COPY package.json pnpm-lock.yaml* ./
RUN corepack enable && npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
