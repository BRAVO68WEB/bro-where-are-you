# =============================================================================
# Bro Where Are You — Web Frontend Environment
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp web/.env.example web/.env
#
# All vars prefixed with VITE_ are exposed to the browser at build time.
# =============================================================================

# --- Hasura -------------------------------------------------------------------
VITE_HASURA_URL=http://localhost:8080/v1/graphql
VITE_HASURA_ADMIN_SECRET=CHANGE_ME

# --- Go Server API ------------------------------------------------------------
VITE_API_URL=http://localhost:8088

# --- OIDC Authentication -----------------------------------------------------
VITE_OIDC_AUTHORITY=https://your-oidc-provider/oidc
VITE_OIDC_CLIENT_ID=your-oidc-client-id
VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback

# --- OneSignal Push Notifications --------------------------------------------
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
VITE_ONESIGNAL_SAFARI_WEB_ID=web.onesignal.auto.your-safari-web-id
